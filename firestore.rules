rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId}
    // Fields:
    //   - uid: string (required)
    //   - email: string (required, format: email)
    //   - displayName: string
    //   - role: string (required, enum: ['admin', 'editor', 'viewer'])
    //   - photoURL: string
    //   - createdAt: string (format: date-time)
    //
    // Collection: contracts
    // Document ID: {contractId}
    // Fields:
    //   - id: string
    //   - title: string (required)
    //   - party: string (required)
    //   - value: number
    //   - currency: string
    //   - startDate: string (format: date)
    //   - endDate: string (format: date)
    //   - status: string (required, enum: ['Draft', 'Review', 'Active', 'Expired', 'Terminated'])
    //   - category: string
    //   - description: string
    //   - owner: string
    //   - lastModified: string (format: date-time)
    //   - authorId: string (required)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        ((request.auth.token.email == "lemonadimat@gmail.com" && request.auth.token.email_verified == true) ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
    }

    function isEditor() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'editor' || isAdmin());
    }

    function isViewer() {
      return isAuthenticated();
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUser(data) {
      return data.uid is string &&
             data.email is string &&
             data.role in ['admin', 'editor', 'viewer'];
    }

    function isValidContract(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.party is string && data.party.size() > 0 && data.party.size() < 200 &&
             data.status in ['Draft', 'Review', 'Active', 'Expired', 'Terminated'] &&
             data.authorId is string;
    }

    // ===============================================================
    // Match Rules
    // ===============================================================

    match /users/{userId} {
      allow get: if isAuthenticated();
      allow list: if isAdmin();
      allow create: if isAuthenticated() && isOwner(userId) && isValidUser(request.resource.data) && (request.resource.data.role == 'viewer' || isAdmin());
      allow update: if isAuthenticated() && (isOwner(userId) || isAdmin()) && isValidUser(request.resource.data) && (request.resource.data.role == resource.data.role || isAdmin());
      allow delete: if isAdmin();
    }

    match /contracts/{contractId} {
      allow read: if isViewer();
      allow create: if isEditor() && isValidContract(request.resource.data) && request.resource.data.authorId == request.auth.uid;
      allow update: if isEditor() && isValidContract(request.resource.data) && (request.resource.data.authorId == resource.data.authorId || isAdmin());
      allow delete: if isAdmin();
    }

    match /invites/{inviteId} {
      allow read: if isAdmin() || (resource.data.status == 'pending');
      allow create: if isAdmin();
      allow update: if isAdmin() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status == 'accepted');
      allow delete: if isAdmin();
    }
  }
}
