# GROQ_API_KEY: Required for Groq AI API calls (contract analysis, legal chat, counterparty research).
# Get your API key at https://console.groq.com
GROQ_API_KEY="MY_GROQ_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Configuration (Vercel/Production)
# Copy these values from your firebase-applet-config.json
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""

# Optional: real Firebase Auth UIDs for demo seed (contracts/notifications).
# If unset, the signed-in admin UID is used for manager/user placeholders.
# VITE_SEED_MANAGER_UID=""
# VITE_SEED_USER_UID=""
